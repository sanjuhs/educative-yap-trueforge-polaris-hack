# Server-side configuration only. Never put these in Vercel browser variables.
YAP_HOSTED=1
HOST=0.0.0.0
STUDIO_PORT=8789
PORT=8790
YAP_DATA_DIR=/app/.data
# Optional one-time encrypted migration manifest; see deployment/history-import.md.
YAP_LEGACY_MANIFEST_KEY=
APP_ORIGIN=https://educative-yap.vercel.app
PUBLIC_APP_URL=https://educative-yap.vercel.app
PUBLIC_STUDIO_URL=https://educative-yap.vercel.app
DATABASE_URL=postgresql://yap:replace-with-private-password@yap-postgres:5432/yap
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-private-initial-password
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=high
OPENAI_TTS_MODEL=gpt-4o-mini-tts
YAP_MCP_SECRET=replace-with-a-random-32-byte-secret
R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
R2_BUCKET=educative-yap-private
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_PREFIX=educative-yap
# Preserve this key with your recovery secrets; changing it strands old encrypted media.
R2_ENCRYPTION_KEY=replace-with-64-hex-characters-from-32-random-bytes
YAP_MODAL_RENDER_URL=https://your-dedicated-modal-api.modal.run
YAP_MODAL_RENDER_TOKEN=replace-with-a-dedicated-random-secret
GENERATION_CONCURRENCY=2
GENERATION_USER_CONCURRENCY=1
GENERATION_MAX_QUEUED=5
SERVER_EXECUTION_TIMEOUT_SECONDS=1800
