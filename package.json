{
  "name": "educative-yap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local educational video studio powered by TrueForge",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "start": "tsx src/start.ts",
    "dev": "tsx src/start.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "demo": "tsx scripts/demo.ts",
    "format": "prettier --write src public scripts tests examples package.json tsconfig.json README.md docs",
    "format:check": "prettier --check src public scripts tests examples package.json tsconfig.json README.md docs",
    "setup:clips": "tsx scripts/setup-clips.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@node-rs/argon2": "^2.2.1",
    "@truefoundry/trueforge": "0.2.1",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "gsap": "3.15.0",
    "hyperframes": "0.8.78",
    "multer": "2.4.0",
    "openai": "7.23.0",
    "pg": "^8.23.0",
    "playwright": "1.63.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "26.6.3",
    "@types/pg": "^8.23.1",
    "agent-browser": "0.27.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
